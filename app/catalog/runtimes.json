      "detect": [
        { "type": "registry", "view": "x64", "key": "SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\X86", "value": "Installed", "equals": 1, "versionValue": "Version", "minVersion": "14.30" }
