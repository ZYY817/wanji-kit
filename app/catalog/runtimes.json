  "version": 1,
  "updatedAt": "2026-10-24",
  "note": "游戏运行库目录（数据驱动）——新增组件 = 在这里加一条记录，不写代码。detect 规则类型：registry/file/command/winsxs；install：winget 优先，download 兜底，都没有则给 manual 链接。",
  "components": [
    {
      "id": "vc2022-x64",
      "name": "Visual C++ 2015–2022 运行库（64位）",
      "short": "VC++ 2022 x64",
      "category": "vcredist",
      "importance": "essential",
      "why": "绝大多数现代游戏与工具的基础依赖",
      "sizeMb": 25,
      "detect": [
        { "type": "registry", "view": "x64", "key": "SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\X64", "value": "Installed", "equals": 1, "versionValue": "Version", "minVersion": "14.30" }
      ],
      "install": {
        "winget": "Microsoft.VCRedist.2015+.x64",
        "download": { "url": "https://aka.ms/vs/17/release/vc_redist.x64.exe", "args": "/install /quiet /norestart" }
      }
    },
    {
      "id": "vc2022-x86",
