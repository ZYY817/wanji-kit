      "id": "netfx48",
      "name": ".NET Framework 4.8",
      "short": ".NET 4.8",
      "category": "dotnet",
      "importance": "essential",
      "why": "大量游戏工具与启动器（MOD 管理器、汉化补丁工具）依赖",
      "sizeMb": 60,
      "detect": [
        { "type": "registry", "view": "x64", "key": "SOFTWARE\\Microsoft\\NET Framework Setup\\NDP\\v4\\Full", "value": "Release", "minInt": 528040 }
      ],
      "install": {
        "download": { "url": "https://go.microsoft.com/fwlink/?linkid=2088631", "args": "/q /norestart", "name": "ndp48-web.exe" }
      }
    },
    {
      "id": "netdesktop8",
      "name": ".NET 桌面运行时 8",
      "short": ".NET 8 Desktop",
      "category": "dotnet",
      "importance": "common",
      "why": "新式工具与启动器（部分 MOD 管理器、游戏工具箱）依赖",
      "sizeMb": 60,
      "detect": [
        { "type": "command", "cmd": "dotnet", "args": "--list-runtimes", "contains": "Microsoft.WindowsDesktop.App 8." }
      ],
      "install": {
        "winget": "Microsoft.DotNet.DesktopRuntime.8",
        "download": { "url": "https://aka.ms/dotnet/8.0/windowsdesktop-runtime-win-x64.exe", "args": "/install /quiet /norestart" }
      }
    },
    {
      "id": "dx-jun2010",
      "name": "DirectX 旧组件（June 2010）",
      "short": "DirectX 9.0c 补件",
      "category": "directx",
      "importance": "essential",
      "why": "DX9/老游戏缺 D3DX9、XAudio、XACT 报的错全是它",
      "sizeMb": 95,
      "detect": [
        { "type": "file", "path": "%WINDIR%\\System32\\D3DX9_43.dll" },
        { "type": "file", "path": "%WINDIR%\\System32\\X3DAudio1_7.dll" },
        { "type": "file", "path": "%WINDIR%\\SysWOW64\\D3DX9_43.dll" }
      ],
      "install": {
        "download": { "url": "https://download.microsoft.com/download/1/7/1/1718CCC4-6315-4D8E-9543-8E28A4E18C4C/dxwebsetup.exe", "args": "/Q" }
      }
    },
    {
      "id": "xna4",
      "name": "XNA Framework 4.0",
      "short": "XNA 4.0",
      "category": "middleware",
      "importance": "common",
      "why": "星露谷物语、泰拉瑞亚、FEZ 等独立游戏必需",
      "sizeMb": 7,
      "detect": [
        { "type": "registry", "view": "x64", "key": "SOFTWARE\\Microsoft\\XNA\\Framework\\v4.0", "value": "Installed", "equals": 1 }
      ],
      "install": {
        "download": { "url": "https://download.microsoft.com/download/A/C/2/AC2C903B-E6E8-42C2-9FD7-BEBAC362A930/xnafx40_redist.msi", "args": "msiexec", "msiArgs": "/i {file} /qn /norestart" }
      }
    },
