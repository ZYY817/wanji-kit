    {
      "id": "power-high",
      "kind": "setting",
      "rec": "switch",
      "name": "高性能电源计划",
      "short": "高性能电源",
      "category": "setting",
      "importance": "low",
      "why": "避免节能策略限制 CPU/GPU 睿频，帧率与加载更稳",
      "sizeMb": 0,
      "detect": [
        {
          "type": "command",
          "cmd": "powercfg",
          "args": "/getactivescheme",
          "contains": "8c5e7fda",
          "or": true
        },
        {
          "type": "command",
          "cmd": "powercfg",
          "args": "/getactivescheme",
          "contains": "5f2b1c8d",
          "or": true
        }
      ],
      "install": {
        "channel": "command",
        "run": "powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c || powercfg /setactive 5f2b1c8d-3e4a-4f6b-9c7d-2e8a1b4c6d8f || (powercfg /duplicatescheme 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c 5f2b1c8d-3e4a-4f6b-9c7d-2e8a1b4c6d8f && powercfg /setactive 5f2b1c8d-3e4a-4f6b-9c7d-2e8a1b4c6d8f)",
        "elevated": false
      }
    },
    {
      "id": "gamemode",
