          "key": "SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{b24cae82-bb64-4ad2-820a-dc2c4031c914}",
          "value": "DisplayName",
          "or": true
        }
      ],
      "install": {
        "manual": {
          "url": "https://dev.epicgames.com/documentation/en-us/unreal-engine/packaging-unreal-engine-projects",
