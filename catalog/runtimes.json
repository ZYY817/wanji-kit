    {
      "id": "directplay",
      "kind": "setting",
      "rec": "on",
      "name": "DirectPlay（旧版组件）",
      "short": "DirectPlay",
      "category": "windows",
      "importance": "optional",
      "why": "2000 年代老游戏联机组件（帝国时代、红警2 等），Windows 可选功能",
      "sizeMb": 1,
      "detect": [
        {
          "type": "file",
          "path": "%WINDIR%\\SysWOW64\\dplayx.dll"
        }
      ],
      "install": {
        "channel": "command",
        "run": "dism /online /enable-feature /featurename:DirectPlay /all /norestart",
        "elevated": true,
        "manual": {
          "url": "ms-settings:optionalfeatures",
          "label": "Windows 功能 → 旧版组件 → DirectPlay"
        }
      }
    },
