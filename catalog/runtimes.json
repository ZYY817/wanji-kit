      "rec": "on",
      "name": "游戏模式 Game Mode",
      "short": "游戏模式",
      "category": "setting",
      "importance": "low",
      "why": "游戏时优先分配 CPU/GPU 资源并压制后台更新",
      "sizeMb": 0,
      "detect": [
        {
          "type": "registry",
          "hive": "hkcu",
